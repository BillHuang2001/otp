/// The tags whose **minimal wire form is the canonical encoding** of the term it
/// decodes to, so the re-encode must reproduce the image byte for byte.
///
/// Every other `Ok` row is a *non-canonical* wire form — the decoder accepts it and the
/// canonical encoder rewrites it — for one of five documented reasons:
///
/// * a **legacy identifier form** the encoder always modernizes (`89`/`101`/`102`/`103`/
///   `114` → `120`/`90`/`88`);
/// * a **legacy scalar/atom form** (`98` → `97` when the value is `< 256`, `99` → `70`,
///   `100`/`115`/`118` → `119`, `105` → `104` for an arity `< 256`, `107` → `106` for an
///   empty list, `108` → `107` for a byte list, `110`/`111` → `97` for a small-fitting
///   magnitude) — the `{minor_version, N}` flavours are what make those forms
///   *producible*, never the default flavour;
/// * a **compression/cache wrapper** that materializes no term of its own (`80`, `82`);
/// * an **identity-by-index form** (`73`/`75`);
/// * a term whose **wire form carries state the term cannot hold** (`112`'s
///   `size`/`old_index`/`old_uniq` and the `make_fun3`-less `uniq` are the runtime's fun
///   entry's, so the canonical image is re-derived rather than copied; `121` is the
///   `[local]` wrapper, which the canonical encoder emits only for a runtime that owns a
///   node hash).
const CANONICAL: &[u8] = &[67, 70, 77, 88, 90, 97, 104, 106, 109, 113, 116, 119, 120];

/// The atom names the sweep seeds once: `minimal_image` needs `a`, `m`, `r` and `f`,
/// and `ATOM_INTERNAL_REF2`/`_REF3` name an atom by **index**, so the table carries a
/// sixth name (`indexed`, index 5) for those two rows.
const SEED: [&str; 6] = ["a", "m", "r", "f", "nil", "indexed"];

/// A decode heap of `words` term words.
fn new_heap(words: usize) -> Heap {
    Heap::new(words).expect("the carrier allocator never fails for these sizes")
}

/// Decodes `image` with the sweep's fixed decoder state — the [`SEED`] atom table plus
/// an [`AtomCache`] whose index 0 is the atom `a` (so the `ATOM_CACHE_REF` row can be
/// `Ok`) — asserting that every byte was consumed (the images are trailing-byte-free,
/// so this is the same strictness `decode_term` applies).
///
/// The heap and atom table are returned with the term, which borrows their storage.
fn decode_with_state(image: &[u8]) -> Result<(Heap, AtomTable, Eterm), BeamError> {
    let mut heap = new_heap(1 << 14);
    let mut atoms = AtomTable::new();
    atoms.seed(SEED);
    let mut cache = AtomCache::new();
    cache.set(0, atoms.lookup("a").expect("seeded"));
    let mut decoder = Decoder::new(image)?.with_atom_cache(&cache);
    let term = decoder.decode(&mut heap, &mut atoms)?;
    decoder.finish()?;
    Ok((heap, atoms, term))
}

/// The disposition a decode **outcome** is — the inverse of a row's expectation, so a
/// class swap (`BadArg` vs `Unsupported` vs `SystemLimit`) is a mismatch rather than a
/// pass. Any other error class is a finding, not a row.
fn classify(outcome: &Result<(Heap, AtomTable, Eterm), BeamError>) -> Disposition {
    match outcome {
        Ok(_) => Disposition::Ok,
        Err(BeamError::BadArg) => Disposition::BadArg,
        Err(BeamError::SystemLimit) => Disposition::SystemLimit,
        Err(other) if is_unsupported(other) => Disposition::Unsupported,
        Err(other) => panic!("an unexpected error class for a tag byte: {other:?}"),
    }
}

/// **The sweep.** Every byte's disposition is decided, and the table that decides it is
/// dense, sorted, and consistent with `Tag::from_byte` in both directions.
#[test]
fn every_tag_byte_has_exactly_one_decided_disposition() {
    // (a) The table is closed: exactly one row per byte, ascending.
    assert_eq!(ROWS.len(), 256, "the sweep must carry one row per byte, 0..=255");
    for (i, row) in ROWS.iter().enumerate() {
        assert_eq!(
            usize::from(row.byte), i,
            "row {i} carries byte {} (`{}`): the table must be dense and sorted",
            row.byte, row.note
        );
    }

    // (b) The disposition follows tag-ness alone: a byte `Tag::from_byte` knows is a
    //     term, and every other byte is malformed. Neither class may drift.
    for row in ROWS {
        let is_tag = Tag::from_byte(row.byte).is_some();
        assert_eq!(
            is_tag,
            row.disposition == Disposition::Ok,
            "byte {} (`{}`): Tag::from_byte knows it = {is_tag}, but the row says {:?}",
            row.byte,
            row.note,
            row.disposition
        );
    }

    // (c) The literal images are the *shared* table's, not a second derivation: for every
    //     tag `tag_images::minimal_image` has an image for, the row must carry exactly it.
    //     The five contextual tags it returns `None` for (73/75/80/82/121) supply decoder
    //     state instead, so their rows are written out here.
    for row in ROWS {
        let Some(tag) = Tag::from_byte(row.byte) else {
            continue;
        };
        let Some(shared) = minimal_image(tag) else {
            continue;
        };
        assert_eq!(
            row.image,
            shared.as_slice(),
            "byte {} (`{}`): the row must carry `tag_images::minimal_image`'s image for \
             {tag:?}, so the two suites cannot drift apart",
            row.byte,
            row.note
        );
    }

    // (d) The exact class every row produces, plus its re-encode behaviour.
    let (mut ok, mut bad_arg) = (0usize, 0usize);
    let mut canonical = 0usize;
    for row in ROWS {
        let byte = row.byte;
        let note = row.note;
        let outcome = decode_with_state(row.image);
        assert_eq!(
            classify(&outcome),
            row.disposition,
            "byte {byte} (`{note}`): image {:?}",
            row.image
        );
        if row.disposition != Disposition::Ok {
            bad_arg += 1;
            continue;
        }
        ok += 1;
        let (_heap, atoms, term) = outcome.expect("an Ok row decodes");
        let encoded = encode_term(term, &atoms)
            .unwrap_or_else(|e| panic!("byte {byte} (`{note}`): the term must re-encode: {e:?}"));
        if CANONICAL.contains(&byte) {
            canonical += 1;
            assert_eq!(
                encoded, row.image,
                "byte {byte} (`{note}`): a canonical image must re-encode byte-identically"
            );
        } else {
            assert_ne!(
                encoded, row.image,
                "byte {byte} (`{note}`): listed as a non-canonical wire form but re-encoded \
                 byte-identically — move it into `CANONICAL` (or fix the row)"
            );
        }
        // Canonicalization is idempotent: the re-encoded image decodes to a term whose
        // canonical encoding is that same image.
        let (_h2, a2, t2) = decode_with_state(&encoded)
            .unwrap_or_else(|e| panic!("byte {byte} (`{note}`): the re-encoded {encoded:?} must decode: {e:?}"));
        assert_eq!(
            encode_term(t2, &a2).expect("the twice-decoded term re-encodes"),
            encoded,
            "byte {byte} (`{note}`): canonicalization must be idempotent"
        );
    }
    assert_eq!(ok + bad_arg, 256);
    assert_eq!(ok, 34, "the covered tag count changed — the audit table must be updated");
    assert_eq!(bad_arg, 222);
    assert_eq!(canonical, CANONICAL.len());
    eprintln!(
        "[beam_codec tag_space_audit] the 256-byte sweep: {ok} Ok ({canonical} canonical, \
         {} canonicalizing), {bad_arg} BadArg, 0 Unsupported, 0 SystemLimit",
        ok - canonical
    );
}

/// The independent "no accidental fall-through" check: `[VERSION_MAGIC][byte]` must
/// return a term or a typed error for **every** byte and never panic (a panic aborts the
/// test process). Exactly one tag is self-contained — `NIL_EXT` (`106`) has no operand
/// — so every other bare byte is a typed `BadArg`.
#[test]
fn no_bare_tag_byte_panics_or_falls_through() {
    let mut self_contained = Vec::new();
    for byte in 0u16..=255 {
        let byte = byte as u8;
        let image = [VERSION_MAGIC, byte];
        let mut heap = new_heap(1 << 12);
        let mut atoms = AtomTable::new();
        match decode_term(&image, &mut heap, &mut atoms) {
            Ok(_) => self_contained.push(byte),
            Err(BeamError::BadArg) => {}
            Err(other) => panic!("bare byte {byte}: expected a term or BadArg, got {other:?}"),
        }
    }
    assert_eq!(
        self_contained,
        vec![106u8],
        "exactly `NIL_EXT` is self-contained (every other tag needs an operand)"
    );
    eprintln!("[beam_codec tag_space_audit] every bare tag byte returned, none panicked");
}

// ===========================================================================
// Part 2 — edge/malformed rows NOT already pinned elsewhere
// ===========================================================================
//
// Already pinned elsewhere (checked row by row, not re-asserted here):
//
// * `FLOAT_EXT`'s grammar — the accepted `,` radix (`"1,5"` ⇒ 1.5) and the rejected
//   `inf`/`-inf`/`nan`/`infinity`/`1e5` (no radix)/`1.`/`.5`/`" 1.0"`/`0x1p3`/`"1.5x"`/
//   `""` — `tests/legacy_scalar_oracle.rs::float_corpus` (offline-pinned *and* live).
// * `NEW_FLOAT_EXT` `inf`/`-inf`/`nan`/signaling-nan ⇒ `badarg` —
//   `tests/scalar_ext_decode.rs::scalar_wire_rules_are_applied` (and
//   `tests/tag_coverage.rs`'s `new_float_infinity`/`new_float_nan`).
// * Bignum sign bytes **1** and **2** (and `5`, `200`) ⇒ negative —
//   `tests/scalar_ext_decode.rs`'s corpus; `255` was the one value missing (below).
// * `BIT_BINARY_EXT` trailing-bit count 0/9/255, `len 0`, and the last byte's unused
//   low bits being zeroed — `src/decode/tests.rs::malformed_binaries_and_bit_strings_are_bad_arg`
//   and `::binary_and_bit_binary_decode`.
// * `MAP_EXT` bit-31 pair count, a duplicate key, and `1`/`1.0` both surviving —
//   `tests/tag_coverage.rs` (`map_pair_count_bit31`, `map_duplicate_key`) and
//   `tests/map_ext_decode.rs::integer_and_float_keys_stay_distinct`.
// * `EXPORT_EXT`'s non-small arity — `src/decode/fun.rs::export_ext_decodes_to_an_external_fun`.
// * `RECORD_EXT` flags byte `2` — `tests/tag_coverage.rs::record_bad_flags_byte`.
// * `NEW_FUN_EXT` `num_free = 256` — `tests/tag_coverage.rs::new_fun_num_free_256`.
// * Tiny creation `3` vs `4` — `tests/legacy_scalar_oracle.rs` (a `NEW_FUN_EXT`
//   creator's legacy `PID_EXT`, live-checked) and `tests/tag_coverage.rs`
//   (`reference_ext_creation_4`/`port_ext_creation_4`/`pid_ext_creation_4`).
// * `NEWER_REFERENCE_EXT` id count 6 — `tests/tag_coverage.rs::newer_reference_len_6`.
// * The six C `dec_atom` positions rejecting the `NIL_EXT` marker behind `LOCAL_EXT` —
//   `tests/tag_coverage.rs`'s `local_*_nil` rows, `src/decode/{fun,record}.rs`'s unit
//   tests.

/// Builds `[VERSION_MAGIC][COMPRESSED][size:4 BE][zlib(body)]`, declaring `declared`
/// as the inflated length (which a caller can get wrong).
fn compressed_image(body: &[u8], declared: u32) -> Vec<u8> {
    let zlib = compress(body, 6).expect("zlib of a tiny body");
    let mut image = vec![VERSION_MAGIC, COMPRESSED_EXT];
    image.extend_from_slice(&declared.to_be_bytes());
    image.extend_from_slice(&zlib);
    image
}

/// Asserts a decay is exactly `BadArg` (never a panic, never `Ok`, never another class).
fn assert_bad_arg(image: &[u8]) {
    match decode_with_state(image) {
        Err(BeamError::BadArg) => {}
        Ok(_) => panic!("expected BadArg for {image:?}, got a term"),
        Err(other) => panic!("expected BadArg for {image:?}, got {other:?}"),
    }
}

/// `SMALL_BIG_EXT` from a **little-endian** magnitude (the wire's digit order).
fn small_big(negative: bool, magnitude_le: &[u8]) -> Vec<u8> {
    let mut image = vec![VERSION_MAGIC, 110, magnitude_le.len() as u8, u8::from(negative)];
    image.extend_from_slice(magnitude_le);
    image
}

/// `2^59 - 1` (`MAX_SMALL`) and `2^59` in little-endian base-256.
const MAX_SMALL_LE: [u8; 8] = [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x07];
/// `2^59` little-endian: one more than `MAX_SMALL`.
const TWO_POW_59_LE: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0x08];
/// `2^59 + 1` little-endian.
const TWO_POW_59_PLUS_1_LE: [u8; 8] = [1, 0, 0, 0, 0, 0, 0, 0x08];

/// A bignum's **sign byte** is a boolean in the C (`neg = get_int8(ep)` is only tested
/// for zero-ness, `big.c:3446-3448`), so `255` negates exactly like `1` and `2` — the
/// values `tests/scalar_ext_decode.rs` pins.
#[test]
fn a_bignum_sign_byte_of_255_negates() {
    assert_bad_arg(&[VERSION_MAGIC, 110, 1, 255]); // truncated magnitude, not a value
    let (_heap, _atoms, term) =
        decode_with_state(&[VERSION_MAGIC, 110, 1, 255, 42]).expect("sign 255 decodes");
    assert!(is_small(term), "a 1-byte magnitude is a small");
    assert_eq!(signed_value(term), -42, "any non-zero sign byte means negative");
}

/// The 60-bit small range on the wire: the C's `bytes_to_big` returns a small exactly
/// when the magnitude fits **and** `IS_USMALL(sgn, d)` holds — `d <= MAX_SMALL` for a
/// positive value but `d <= MAX_SMALL + 1` for a negative one (`big.h:76`), so `-2^59`
/// is `MIN_SMALL` (a small) while `+2^59` is a bignum. Decoding a magnitude through
/// `SMALL_BIG_EXT` must split at that same boundary in both directions.
#[test]
fn the_bignum_small_range_boundary_is_exact() {
    let (_h, _a, at_max) = decode_with_state(&small_big(false, &MAX_SMALL_LE)).expect("2^59-1");
    assert!(is_small(at_max), "2^59-1 is MAX_SMALL, a small");
    assert_eq!(signed_value(at_max), (1i64 << 59) - 1);

    let (_h, _a, over) = decode_with_state(&small_big(false, &TWO_POW_59_LE)).expect("2^59");
    assert!(!is_small(over), "2^59 is one past MAX_SMALL, so a bignum");
    let (negative, digits) = big_parts(over).expect("a bignum");
    assert!(!negative);
    assert_eq!(digits, &[1u64 << 59], "2^59 as a single digit");

    let (_h, _a, min_small) = decode_with_state(&small_big(true, &TWO_POW_59_LE)).expect("-2^59");
    assert!(is_small(min_small), "-2^59 is MIN_SMALL, a small");
    assert_eq!(signed_value(min_small), -(1i64 << 59));

    let (_h, _a, neg_over) =
        decode_with_state(&small_big(true, &TWO_POW_59_PLUS_1_LE)).expect("-(2^59+1)");
    assert!(!is_small(neg_over), "-(2^59+1) is past MIN_SMALL, so a bignum");
    let (negative, digits) = big_parts(neg_over).expect("a bignum");
    assert!(negative);
    assert_eq!(digits, &[(1u64 << 59) + 1], "-(2^59+1) as a single digit");
}

/// The `COMPRESSED` (`80`) rows `tests/compressed_decode.rs` does not already pin. That
/// suite covers a declared size that is too small/too large (1 and 7 against a 6-byte
/// body), a valid stream of an *empty* body, a non-term body, a non-zlib payload, a
/// truncated/corrupt stream, and `COMPRESSED` as a nested **term** tag; what is left is
/// the 1-byte body at both ends of the size field, a body that begins with the version
/// byte, and a body that is itself a `COMPRESSED` wrapper (the wrapper is
/// top-level-only, so a nested wrapper must not be unwrapped).
#[test]
fn compressed_rows_not_pinned_by_the_specialised_suite() {
    // A one-byte body that is *not* a whole term, with the declared size at both ends.
    assert_bad_arg(&compressed_image(&[97], 0));
    assert_bad_arg(&compressed_image(&[97], 2));

    // A body that re-introduces `VERSION_MAGIC`: the inflated bytes are a *body*, never
    // an image, so `131` is not a tag there (`external.c:1759` unwraps exactly once).
    assert_bad_arg(&compressed_image(&[VERSION_MAGIC, 97, 0], 3));

    // A body that is itself a `COMPRESSED` wrapper: accepted only as the outer wrapper.
    let inner = compressed_image(&[97, 0], 2);
    assert_bad_arg(&compressed_image(&inner, inner.len() as u32));

    // The same body without the extra layer really does decode, so the rows above fail
    // for the wrapper and not for the body.
    let (.., term) = decode_with_state(&compressed_image(&[97, 0], 2)).expect("a plain wrapper");
    assert!(is_small(term) && signed_value(term) == 0);
}

// ===========================================================================
// Part 3 — the live oracle cross-check
// ===========================================================================

/// Resolve the oracle: `$ERTS_ORACLE` if it is an existing executable, else `erl` on
/// `$PATH` (the policy of `tests/interop.rs` and `tools/differential`).
fn resolve_oracle() -> Option<PathBuf> {
    if let Some(value) = std::env::var_os("ERTS_ORACLE") {
        let program = PathBuf::from(&value);
        if program.is_file() {
            return Some(program);
        }
        eprintln!(
            "[beam_codec tag_space_audit] $ERTS_ORACLE='{}' is not an existing executable — \
             treating it as no oracle.",
            program.display()
        );
        return None;
    }
    let path = std::env::var_os("PATH")?;
    std::env::split_paths(&path)
        .filter(|dir| !dir.as_os_str().is_empty())
        .map(|dir| dir.join("erl"))
        .find(|candidate| candidate.is_file())
}

/// The oracle, or a **loud** skip (never a silent pass).
fn oracle_or_skip(test: &str) -> Option<PathBuf> {
    match resolve_oracle() {
        Some(oracle) => Some(oracle),
        None => {
            eprintln!(
                "[beam_codec tag_space_audit] {test}: SKIPPED — no `erl`/`$ERTS_ORACLE` on this \
                 machine; the live tag-space cross-check did not run (NOT a pass). \
                 ($ERTS_ORACLE unset or not executable, and no `erl` on $PATH)."
            );
            None
        }
    }
}

fn run_erl(oracle: &Path, eval: &str) -> String {
    let out = Command::new(oracle)
        .arg("-noshell")
        .arg("-eval")
        .arg(eval)
        .arg("-s")
        .arg("init")
        .arg("stop")
        .stdin(Stdio::null())
        .output()
        .expect("spawn the oracle");
    assert!(
        out.status.success(),
        "the oracle exited {:?}: {}",
        out.status,
        String::from_utf8_lossy(&out.stderr)
    );
    String::from_utf8(out.stdout).expect("the oracle prints UTF-8")
}

/// `<<b0,b1,…>>` — the Erlang binary literal the oracle's `-eval` accepts.
fn erl_binary(bytes: &[u8]) -> String {
    let joined = bytes.iter().map(u8::to_string).collect::<Vec<_>>().join(",");
    format!("<<{joined}>>")
}

/// The oracle's class for each image, in one batched `erl` spawn: `ok` when
/// `binary_to_term/1` returns, `badarg` when it raises.
fn oracle_classes(oracle: &Path, images: &[Vec<u8>]) -> Vec<String> {
    let list = images.iter().map(|b| erl_binary(b)).collect::<Vec<_>>().join(",");
    let eval = format!(
        "F = fun(B) -> try binary_to_term(B), ok catch _:_ -> badarg end end, \
         io:format(\"~w~n\", [[F(B) || B <- [{list}]]])"
    );
    let out = run_erl(oracle, &eval);
    let inner = out
        .trim()
        .strip_prefix('[')
        .and_then(|s| s.strip_suffix(']'))
        .unwrap_or_else(|| panic!("unparsable oracle output: {out:?}"));
    if inner.trim().is_empty() {
        return Vec::new();
    }
    inner.split(',').map(|t| t.trim().to_string()).collect()
}

/// The oracle's expected class for a row, or `None` when the row is **not
/// cross-checkable**:
///
/// * `LOCAL_EXT` (`121`) — the 4-byte node hash is a per-VM-start secret of the
///   oracle's, so it rejects every synthetic `[local]` image for the *hash*;
/// * `ATOM_INTERNAL_REF2`/`_REF3` (`73`/`75`) — they name an atom by **index**, and the
///   two atom tables hold different atoms at index 5;
/// * `ATOM_CACHE_REF` (`82`) — the index only resolves against a distribution atom cache
///   the oracle has not installed in a plain `-eval`.
fn oracle_class_of(byte: u8) -> Option<&'static str> {
    match byte {
        73 | 75 | 82 | 121 => None,
        _ if ROWS[usize::from(byte)].disposition == Disposition::Ok => Some("ok"),
        _ => Some("badarg"),
    }
}

/// The oracle agrees with the sweep — for every cross-checkable byte — and with the
/// Part-2 edge images. Skips loudly without an oracle.
#[test]
fn the_oracle_agrees_with_the_tag_space() {
    let Some(oracle) = oracle_or_skip("the_oracle_agrees_with_the_tag_space") else {
        return;
    };

    let mut labels: Vec<String> = Vec::new();
    let mut images: Vec<Vec<u8>> = Vec::new();
    let mut expected: Vec<&'static str> = Vec::new();
    for row in ROWS {
        let Some(class) = oracle_class_of(row.byte) else {
            continue;
        };
        labels.push(format!("byte {}", row.byte));
        images.push(row.image.to_vec());
        expected.push(class);
    }
    let sweep_rows = images.len();

    // The Part-2 edge images: the sign-byte and small-range rows are `ok`, the
    // `COMPRESSED` rows are `badarg` (all verified against erts-17.1).
    for (label, image, class) in [
        ("sign_255", small_big_flipped(42), "ok"),
        ("2_pow_59_minus_1", small_big(false, &MAX_SMALL_LE), "ok"),
        ("2_pow_59", small_big(false, &TWO_POW_59_LE), "ok"),
        ("minus_2_pow_59", small_big(true, &TWO_POW_59_LE), "ok"),
        ("minus_2_pow_59_plus_1", small_big(true, &TWO_POW_59_PLUS_1_LE), "ok"),
        ("compressed_size_0_for_a_1_byte_body", compressed_image(&[97], 0), "badarg"),
        ("compressed_size_2_for_a_1_byte_body", compressed_image(&[97], 2), "badarg"),
        ("compressed_body_starts_with_131", compressed_image(&[VERSION_MAGIC, 97, 0], 3), "badarg"),
        ("compressed_body_is_a_wrapper", compressed_image(&[97, 0], 2), "ok"),
    ] {
        labels.push(label.to_string());
        images.push(image);
        expected.push(class);
    }

    let theirs = oracle_classes(&oracle, &images);
    assert_eq!(theirs.len(), images.len(), "the oracle classified every row");
    for ((label, want), got) in labels.iter().zip(&expected).zip(&theirs) {
        assert_eq!(
            got, want,
            "{label}: the oracle says {got:?}, we say {want:?} — a real divergence"
        );
    }
    eprintln!(
        "[beam_codec tag_space_audit] the oracle agreed on {sweep_rows} cross-checkable tag \
         bytes and {} edge images ({} rows skipped: LOCAL_EXT/ATOM_INTERNAL_REF*/ATOM_CACHE_REF)",
        images.len() - sweep_rows,
        ROWS.len() - sweep_rows
    );
}

/// A `SMALL_BIG_EXT` image with sign byte `255` and magnitude `42` — the negation value
/// `tests/scalar_ext_decode.rs` does not pin.
fn small_big_flipped(value: u8) -> Vec<u8> {
    vec![VERSION_MAGIC, 110, 1, 255, value]
}
