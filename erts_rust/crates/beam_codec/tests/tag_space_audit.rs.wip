//! **The exhaustive tag-space audit.** The central claim it pins is that the
//! disposition of *every* tag byte is **decided, not accidental**: no byte can be
//! silently added, dropped or reclassified later.
//!
//! Part 1 (the dense 256-byte sweep) is one table with **exactly one row per byte
//! `0..=255`, in ascending order** — the table's density and sortedness are asserted,
//! which is what makes the sweep closed. For each row the exact image is decoded and
//! the **exact** outcome class asserted (`Ok` / `BadArg` / `Unsupported` /
//! `SystemLimit` — never a class swap), and for an `Ok` row the term is re-encoded:
//! byte-identically for the tags whose minimal wire form is canonical, and to a
//! *different* canonical image for the decode-only / legacy / compressed / cached
//! forms (asserted both ways, so no tag can silently change side). A second,
//! independent assertion decodes `[131, byte]` for all 256 bytes: it must return a
//! term or a typed error and **never panic** — the "no accidental fall-through" check
//! `src/tag.rs`'s sample test cannot give.
//!
//! Part 2 pins only the edge/malformed rows **not already pinned** by
//! `tests/tag_coverage.rs`, `tests/scalar_ext_decode.rs`, `tests/compressed_decode.rs`,
//! `tests/legacy_scalar_oracle.rs`, `tests/decode_bound_oracle.rs`,
//! `tests/refc_decode.rs` and `tests/map_ext_decode.rs` (see §"Already pinned
//! elsewhere" below — the audit's dedup record).
//!
//! Part 3 is the live cross-check: the system `erl`'s `binary_to_term/1` must classify
//! every cross-checkable image the same way we do. Images holding a `LOCAL_EXT` (`121`)
//! wrapper, an `ATOM_INTERNAL_REF2`/`_REF3` (`73`/`75`) or an `ATOM_CACHE_REF` (`82`)
//! are **excluded** — see [`oracle_class_of`].
//!
//! **Why this file is long:** the 256-row table is data, one row per byte, written out
//! literally so a reviewer can diff a changed disposition byte by byte. The per-tag
//! minimal images themselves are *not* re-derived here: they are
//! [`tag_images::minimal_image`]'s, shared with `tests/tag_coverage.rs`.

use std::path::{Path, PathBuf};
use std::process::{Command, Stdio};

use beam_alloc::Heap;
use beam_common::BeamError;
use beam_term::prelude::{is_small, signed_value, AtomTable, Eterm};

use beam_codec::compress::compress;
use beam_codec::term::big_parts;
use beam_codec::{
    decode_term, encode_term, is_unsupported, AtomCache, Decoder, Tag, COMPRESSED_EXT, VERSION_MAGIC,
};

/// The per-tag minimal images, shared with `tests/tag_coverage.rs` (never re-derived
/// here: a second copy would be free to drift from the one that suite pins).
mod tag_images;

use tag_images::minimal_image;

// ===========================================================================
// Part 1 — the dense 256-byte sweep
// ===========================================================================

/// What a decoder must do with a byte in tag position.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
enum Disposition {
    /// A term is produced.
    Ok,
    /// Malformed input: the C `B2TBadArg` class (`external.c:1989-1991`).
    BadArg,
    /// A *capability* gap: a term kind the wire carries but this crate refuses
    /// (`error::UNSUPPORTED_REASON`). Unreachable from a tag byte alone — no row uses
    /// it, and the sweep asserts that.
    Unsupported,
    /// A resource bound, not malformed input (only a nesting depth past
    /// `MAX_DECODE_DEPTH`). Also unreachable from a tag byte alone.
    SystemLimit,
}

/// One row of the sweep: the byte in tag position, the minimal image that carries it,
/// the **exact** expected outcome class, and the C/`external.h` reference.
struct Row {
    byte: u8,
    image: &'static [u8],
    disposition: Disposition,
    note: &'static str,
}

/// The row every byte that is **not** a term tag gets: `[VERSION_MAGIC][byte]`, which
/// the term walker can only reject.
const NOT_A_TAG: &str = "no term tag at this byte (external.h), so badarg";

/// Exactly one row per byte `0..=255`, ascending.
///
/// The 37 tag bytes are `external.h`'s term tags (`Tag::from_byte`); every other byte
